{
  "note": "Free-tier LLM providers tried in order after Gemini. Keyed providers are used only when their key is configured; ones without a key (or with keyOptional) also work anonymously. Models are discovered live unless a fixed free list is given. Source list: https://github.com/mnfst/awesome-free-llm-apis. Limits change often; see README.",
  "order": ["workers-ai", "groq", "cerebras", "openrouter", "mistral", "nvidia", "ollama", "zai", "kilo", "llm7", "ovh"],
  "maxModelsPerProvider": 2,
  "exclude": "embed|whisper|tts|guard|rerank|moderation|ocr|transcri|speech|audio|image|vision|vl-|-vl|safety|prompt-guard",
  "providers": {
    "workers-ai": {
      "name": "Cloudflare Workers AI",
      "kind": "workers-ai",
      "worker": true,
      "agent": false,
      "models": ["@cf/qwen/qwen2.5-coder-32b-instruct", "@cf/meta/llama-3.3-70b-instruct-fp8-fast"]
    },
    "groq": {
      "name": "Groq",
      "kind": "openai",
      "base": "https://api.groq.com/openai/v1",
      "key": "GROQ_API_KEY",
      "signup": "https://console.groq.com/keys",
      "prefer": ["kimi-k2", "gpt-oss-120b", "llama-3.3-70b", "qwen"]
    },
    "cerebras": {
      "name": "Cerebras",
      "kind": "openai",
      "base": "https://api.cerebras.ai/v1",
      "key": "CEREBRAS_API_KEY",
      "signup": "https://cloud.cerebras.ai",
      "prefer": ["qwen-3-coder", "gpt-oss", "glm", "qwen", "llama"]
    },
    "openrouter": {
      "name": "OpenRouter (free models)",
      "kind": "openai",
      "base": "https://openrouter.ai/api/v1",
      "key": "OPENROUTER_API_KEY",
      "signup": "https://openrouter.ai/settings/keys",
      "freeOnly": true,
      "prefer": ["qwen3-coder", "deepseek", "kimi", "gpt-oss", "llama-3.3", "nemotron"]
    },
    "mistral": {
      "name": "Mistral",
      "kind": "openai",
      "base": "https://api.mistral.ai/v1",
      "key": "MISTRAL_API_KEY",
      "signup": "https://console.mistral.ai/api-keys",
      "prefer": ["codestral-latest", "mistral-medium-latest", "mistral-small-latest"]
    },
    "nvidia": {
      "name": "NVIDIA NIM",
      "kind": "openai",
      "base": "https://integrate.api.nvidia.com/v1",
      "key": "NVIDIA_API_KEY",
      "signup": "https://build.nvidia.com",
      "prefer": ["qwen3-coder", "deepseek", "llama-3.3-70b", "nemotron"]
    },
    "ollama": {
      "name": "Ollama Cloud",
      "kind": "openai",
      "base": "https://ollama.com/v1",
      "key": "OLLAMA_API_KEY",
      "signup": "https://ollama.com/settings/keys",
      "prefer": ["deepseek-v4-pro", "kimi-k3", "qwen3.5", "deepseek-v4-flash", "gpt-oss:120b"]
    },
    "zai": {
      "name": "Z AI (GLM Flash)",
      "kind": "openai",
      "base": "https://api.z.ai/api/paas/v4",
      "key": "ZAI_API_KEY",
      "signup": "https://z.ai/manage-apikey/apikey-list",
      "models": ["glm-4.7-flash"]
    },
    "kilo": {
      "name": "Kilo Code free pool (no key)",
      "kind": "openai",
      "base": "https://api.kilo.ai/api/gateway",
      "freeOnly": true,
      "prefer": ["kilo-auto/free", "nemotron-3-ultra", "qwen3.8", "laguna-s"]
    },
    "llm7": {
      "name": "LLM7.io (key optional)",
      "kind": "openai",
      "base": "https://api.llm7.io/v1",
      "key": "LLM7_API_KEY",
      "keyOptional": true,
      "signup": "https://token.llm7.io",
      "prefer": ["deepseek-v4", "gpt-oss", "minimax"]
    },
    "ovh": {
      "name": "OVHcloud AI Endpoints (no key, EU)",
      "kind": "openai",
      "base": "https://oai.endpoints.kepler.ai.cloud.ovh.net/v1",
      "prefer": ["qwen3.5-397b", "gpt-oss-120b", "qwen3.8"]
    }
  }
}
