name: AI Audit
on:
  issue_comment:
    types: [created]

jobs:
  audit:
    # Only run if the comment contains the trigger phrase
    if: contains(github.event.comment.body, '/audit-code')
    runs-on: ubuntu-latest
    permissions:
      contents: read
      issues: write
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Run Audit Logic
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          echo "Audit triggered for issue #${{ github.event.issue.number }}"
          # Add your custom script or logic here
          # Example: python3 scripts/analyze.py --issue ${{ github.event.issue.number }}
